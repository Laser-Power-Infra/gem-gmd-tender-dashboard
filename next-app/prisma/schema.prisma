generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model gmd_gem_ids {
  id            Int       @id @default(autoincrement())
  gem_id        String    @unique @db.VarChar(255)
  drive_link    String?
  order_pdf     String?
  remarks       String?
  user_status   String?
  order_number  String?
  docket_number String?
  rate          String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model gmd_gem_files {
  id         Int       @id @default(autoincrement())
  gem_id     String    @db.VarChar(255)
  file_name  String    @db.VarChar(255)
  drive_link String
  file_type  String?   @default("pdf") @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([gem_id], map: "idx_gmd_files_gem_id")
}

