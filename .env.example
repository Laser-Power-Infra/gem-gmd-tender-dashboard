# ========================================================
# Database Configuration (PostgreSQL / SQLite)
# ========================================================
DATABASE_URL=postgresql://user:password@localhost:5432/gmd_gem_ids

# ========================================================
# Google Drive API & OAuth Credentials
# ========================================================
GDRIVE_FOLDER_ID=your_gdrive_folder_id_here
GDRIVE_CLIENT_ID=your_gdrive_client_id_here
GDRIVE_CLIENT_SECRET=your_gdrive_client_secret_here
GDRIVE_REFRESH_TOKEN=your_gdrive_refresh_token_here

# ========================================================
# Server & Port Configurations
# ========================================================
PORT=6001
NEXT_PORT=6012
SCHEDULER_INTERVAL=7200
BACKEND_API_URL=http://127.0.0.1:6001
